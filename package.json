{
  "name": "seeding-script",
  "version": "0.1.0",
  "private": true,
  "description": "Pull two years of start.gg results for every registrant of an event, and a local app to seed from them.",
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
