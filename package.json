{
  "name": "seeding-ops",
  "version": "0.3.0",
  "private": true,
  "description": "Seeding ops for FGC tournaments: pull two years of start.gg results for every registrant, tier players, and seed from one local page.",
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node app/server.js --open",
    "dev": "node --watch app/server.js",
    "app": "node app/server.js",
    "test": "node --test",
    "pull": "node pull.js",
    "seed": "node seed.js",
    "schedule": "node scripts/pull-schedule.js",
    "sidecar": "node scripts/build-sidecar.mjs",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
