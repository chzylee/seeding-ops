{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Seeding Ops",
  "version": "0.3.0",
  "identifier": "net.enpicie.seeding-ops",

  "build": {
    "frontendDist": "shell"
  },

  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },

  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/seeding-server"],

    "resources": {
      "../app": "app",
      "../lib": "lib",
      "../config": "config",
      "../views": "views",
      "../registry/tiers.template.csv": "registry/tiers.template.csv",
      "installed.json": "installed.json",
      "../pull.js": "",
      "../seed.js": "",
      "../package.json": "",
      "../README.md": ""
    },

    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
